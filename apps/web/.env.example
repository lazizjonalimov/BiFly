# Where the Next.js server reaches the FlyFleet API. Used server-side only; it is never sent to the browser.
FLYFLEET_API_URL=http://localhost:8000

# Preview/demo only: allow the app to be shown inside another site's frame (hosted preview panes, IDE
# browsers). This turns off clickjacking protection and issues the session cookie for cross-site frames.
# Never enable it in production.
# FLYFLEET_ALLOW_EMBEDDING=true
