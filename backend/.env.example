TMS_ENV=development
# Runtime role: must NOT be a superuser or the table owner, or row-level security is bypassed.
TMS_DATABASE_URL=postgresql+psycopg://tms_app:tms_app_dev@localhost:5432/tms
# Owner role, used only by Alembic.
TMS_MIGRATION_DATABASE_URL=postgresql+psycopg://tms_owner:tms_owner_dev@localhost:5432/tms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TMS_JWT_SECRET=
TMS_CORS_ORIGINS=["http://localhost:3000"]
TMS_SIGNUP_ENABLED=true
