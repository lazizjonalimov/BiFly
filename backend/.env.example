FLYFLEET_ENV=development
# Runtime role: must NOT be a superuser or the table owner, or row-level security is bypassed.
FLYFLEET_DATABASE_URL=postgresql+psycopg://flyfleet_app:flyfleet_app_dev@localhost:5432/flyfleet
# Owner role, used only by Alembic.
FLYFLEET_MIGRATION_DATABASE_URL=postgresql+psycopg://flyfleet_owner:flyfleet_owner_dev@localhost:5432/flyfleet
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLYFLEET_JWT_SECRET=
# Keys for encrypting sensitive columns (driver licence numbers). Comma-separated: the first encrypts, all
# decrypt, so rotate by putting the new key first and keeping the old one. Empty = built-in development key.
# Required in production. Losing these keys makes the encrypted values unrecoverable: back them up.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLYFLEET_FIELD_ENCRYPTION_KEYS=
FLYFLEET_CORS_ORIGINS=["http://localhost:3000"]
FLYFLEET_SIGNUP_ENABLED=true
# How many active companies one account may hold.
FLYFLEET_MAX_COMPANIES_PER_ACCOUNT=10
