TMS_ENV=development
# Runtime role: must NOT be a superuser or the table owner, or row-level security is bypassed.
TMS_DATABASE_URL=postgresql+psycopg://tms_app:tms_app_dev@localhost:5432/tms
# Owner role, used only by Alembic.
TMS_MIGRATION_DATABASE_URL=postgresql+psycopg://tms_owner:tms_owner_dev@localhost:5432/tms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TMS_JWT_SECRET=
# Keys for encrypting sensitive columns (driver licence numbers). Comma-separated: the first encrypts, all
# decrypt, so rotate by putting the new key first and keeping the old one. Empty = built-in development key.
# Required in production. Losing these keys makes the encrypted values unrecoverable: back them up.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TMS_FIELD_ENCRYPTION_KEYS=
TMS_CORS_ORIGINS=["http://localhost:3000"]
TMS_SIGNUP_ENABLED=true
